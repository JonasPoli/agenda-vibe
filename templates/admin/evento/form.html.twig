{% extends 'admin/base.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}

{% set editando = evento.id is not null %}

{% block title %}{{ editando ? 'Editar evento' : 'Novo evento' }}{% endblock %}

{% block body %}
    <wa-breadcrumb>
        <wa-breadcrumb-item href="{{ path('admin_evento_index') }}">Eventos</wa-breadcrumb-item>
        <wa-breadcrumb-item>{{ editando ? evento.titulo : 'Novo evento' }}</wa-breadcrumb-item>
    </wa-breadcrumb>

    <h1 class="wa-heading-xl">{{ editando ? 'Editar evento' : 'Novo evento' }}</h1>

    {{ form_start(form, {attr: {class: 'wa-stack wa-gap-l', novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}

        <wa-card>
            <h2 slot="header" class="wa-heading-s">Informações</h2>
            <div class="wa-stack wa-gap-l">
                {{ form_row(form.titulo) }}
                <div class="wa-grid wa-gap-l">
                    {{ form_row(form.categoria) }}
                    {{ form_row(form.local) }}
                </div>
                {{ form_row(form.slug) }}
                {{ form_row(form.resumo) }}
                {{ form_row(form.descricao) }}
            </div>
        </wa-card>

        <wa-card>
            <h2 slot="header" class="wa-heading-s">Data e situação</h2>
            <div class="wa-stack wa-gap-l">
                <div class="wa-grid wa-gap-l">
                    {{ form_row(form.inicio) }}
                    {{ form_row(form.fim) }}
                </div>
                {{ form_row(form.ativo) }}
                {{ form_row(form.destaque) }}
                {% if editando and evento.ativo and not evento.categoria.ativa %}
                    <wa-callout variant="warning">
                        <wa-icon slot="icon" name="eye-slash"></wa-icon>
                        A categoria “{{ evento.categoria.nome }}” está inativa, então este evento não aparece no site.
                    </wa-callout>
                {% endif %}
            </div>
        </wa-card>

        <div class="wa-cluster wa-gap-s">
            <wa-button type="submit" variant="brand">
                <wa-icon slot="start" name="floppy-disk"></wa-icon> {{ editando ? 'Salvar alterações' : 'Criar evento' }}
            </wa-button>
            <wa-button appearance="plain" href="{{ path('admin_evento_index') }}">Cancelar</wa-button>
        </div>
    {{ form_end(form) }}

    {% if editando %}
        <wa-divider></wa-divider>
        <form method="post" action="{{ path('admin_evento_excluir', {id: evento.id}) }}"
              data-turbo-confirm="Excluir o evento “{{ evento.titulo }}”? Esta ação não pode ser desfeita.">
            <input type="hidden" name="_token" value="{{ csrf_token('excluir' ~ evento.id) }}">
            <wa-button type="submit" variant="danger" appearance="outlined" size="s">
                <wa-icon slot="start" name="trash"></wa-icon> Excluir evento
            </wa-button>
        </form>
    {% endif %}
{% endblock %}
