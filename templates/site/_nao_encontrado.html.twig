{#
    Bloco "não encontrado" no visual do site.
    Parâmetros: titulo, texto, sugestoes (lista de eventos, opcional).
#}
<section class="relative overflow-hidden">
    <div class="pointer-events-none absolute -top-24 -right-24 h-80 w-80 rounded-full bg-vibe-400/25 blur-3xl"></div>
    <div class="pointer-events-none absolute top-48 -left-32 h-72 w-72 rounded-full bg-vibe-100 blur-3xl"></div>

    <div class="relative mx-auto flex max-w-3xl flex-col items-center px-5 pt-20 pb-16 text-center">
        {# Ingresso rasgado: o "404" no lugar da data #}
        <div class="relative -rotate-3">
            <div class="flex items-stretch overflow-hidden rounded-3xl bg-tinta text-papel shadow-2xl">
                <div class="flex flex-col items-center justify-center bg-vibe-500 px-6 py-5 text-white">
                    <span class="text-xs font-semibold tracking-widest text-white/80 uppercase">erro</span>
                    <span class="font-display text-6xl leading-none font-extrabold">404</span>
                </div>
                <div class="flex flex-col justify-center gap-1 border-l-2 border-dashed border-papel/25 px-6 py-5 text-left">
                    <span class="text-xs font-semibold tracking-widest text-vibe-400 uppercase">Ingresso</span>
                    <span class="font-display text-xl font-bold">Sessão indisponível</span>
                    <span class="text-sm text-papel/60">Fila · Cadeira · ???</span>
                </div>
            </div>
        </div>

        <h1 class="mt-12 font-display text-4xl leading-tight font-extrabold tracking-tight sm:text-5xl">{{ titulo }}</h1>
        <p class="mt-4 max-w-xl text-lg text-tinta/70">{{ texto }}</p>

        <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href="{{ path('site_inicio') }}#agenda" class="inline-flex items-center gap-2 rounded-full bg-vibe-500 px-6 py-3 font-semibold text-white shadow-lg shadow-vibe-500/30 transition hover:-translate-y-0.5 hover:bg-vibe-600">
                Ver a agenda completa
            </a>
            <a href="{{ path('site_inicio') }}" class="inline-flex items-center gap-2 rounded-full px-6 py-3 font-semibold ring-1 ring-tinta/15 transition hover:bg-white">
                Página inicial
            </a>
        </div>
    </div>
</section>

{% if sugestoes|default([]) is not empty %}
    <section class="mx-auto max-w-6xl px-5">
        <h2 class="text-center font-display text-2xl font-bold">Que tal um destes?</h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-3">
            {% for evento in sugestoes %}
                <a href="{{ path('site_evento', {slug: evento.slug}) }}" class="group flex gap-4 rounded-3xl bg-white p-5 ring-1 ring-tinta/10 transition hover:-translate-y-1 hover:shadow-lg">
                    {% include 'site/_data.html.twig' with {data: evento.inicio} %}
                    <div class="min-w-0">
                        {% include 'site/_categoria.html.twig' with {categoria: evento.categoria} %}
                        <h3 class="mt-1 font-display font-bold group-hover:text-vibe-600">{{ evento.titulo }}</h3>
                        <p class="mt-1 truncate text-sm text-tinta/60">{{ evento.local }}</p>
                    </div>
                </a>
            {% endfor %}
        </div>
    </section>
{% endif %}
